# Development Dockerfile for local testing with hot reload
FROM cgr.dev/chainguard/node:latest-dev 

# Run as root for installation
USER root

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Change ownership to node user
RUN chown -R node:node /app

# Switch back to non-root user
USER node

# Expose Vite dev server port
EXPOSE 5173

# The Chainguard Node image supplies node as its entrypoint. Set npm
# explicitly so `podman run ... test` and the Makefile targets work as expected.
ENTRYPOINT ["npm"]
CMD ["run", "dev", "--", "--host", "0.0.0.0"]
